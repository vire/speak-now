{
  "name": "speak-now",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:native && bun run build:client && bun --watch src/server.ts",
    "build:client": "bun build src/client.tsx --target browser --outdir public/assets --minify",
    "build:native": "bun scripts/build-flock-guard.mjs",
    "build": "bun run build:native && bun run build:client",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
